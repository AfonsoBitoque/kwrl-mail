# Maintainer: Afonso Bitoque <dev@kwrl.app>
pkgname=kwrl-desktop
pkgver=0.2.0
pkgrel=1
pkgdesc="Calm, private, local-first email client with local llama.cpp AI and Gmail OAuth2"
arch=('x86_64' 'aarch64')
url="https://github.com/AfonsoBitoque/kwrl-mail"
license=('MIT')
provides=('kwrl' 'corvo-desktop')
conflicts=('corvo-desktop')
replaces=('corvo-desktop')
depends=(
    'webkit2gtk-4.1'
    'gtk3'
    'cairo'
    'glib2'
    'openssl'
    'gnome-keyring'
)
optdepends=(
    'cuda: Aceleração de inferência por GPU NVIDIA (requer compilação com --features cuda)'
    'vulkan-icd-loader: Aceleração de inferência por GPU Vulkan (requer compilação com --features vulkan)'
)
makedepends=(
    'rust'
    'cargo'
    'nodejs'
    'npm'
    'cmake'
    'gcc'
    'clang'
)
source=()

build() {
    # Suporta compilação direta no repositório clonado
    if [ -f "${startdir}/../../package.json" ]; then
        cd "${startdir}/../.."
    fi

    # 1. Compila os assets web de produção com Vite
    npm install
    npm run build

    # 2. Compila os binários Rust em release
    # Nota: para ativar aceleração CUDA passe CARGO_FEATURES="--features cuda"
    # ou para Vulkan passe CARGO_FEATURES="--features vulkan"
    npx tauri build --no-bundle ${CARGO_FEATURES:-}
    cargo build --manifest-path src-tauri/Cargo.toml --release --bin kwrl-llm-worker ${CARGO_FEATURES:-}
}

package() {
    local ROOT_DIR="."
    if [ -f "${startdir}/../../package.json" ]; then
        ROOT_DIR="${startdir}/../.."
    fi

    # Binários principais (aplicação desktop e processo sidecar isolado llama.cpp)
    install -Dm755 "${ROOT_DIR}/src-tauri/target/release/kwrl" "${pkgdir}/usr/bin/kwrl"
    install -Dm755 "${ROOT_DIR}/src-tauri/target/release/kwrl-llm-worker" "${pkgdir}/usr/bin/kwrl-llm-worker"

    # Symlinks para manter compatibilidade retroativa
    ln -sf /usr/bin/kwrl "${pkgdir}/usr/bin/corvo-desktop"
    ln -sf /usr/bin/kwrl-llm-worker "${pkgdir}/usr/bin/corvo-llm-worker"

    # Entrada no lançador de aplicações (.desktop)
    install -Dm644 "${ROOT_DIR}/packaging/linux/kwrl.desktop" "${pkgdir}/usr/share/applications/kwrl.desktop"

    # Ícones da aplicação
    install -Dm644 "${ROOT_DIR}/src-tauri/icons/32x32.png" "${pkgdir}/usr/share/icons/hicolor/32x32/apps/kwrl.png"
    install -Dm644 "${ROOT_DIR}/src-tauri/icons/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/kwrl.png"
    install -Dm644 "${ROOT_DIR}/src-tauri/icons/icon.png" "${pkgdir}/usr/share/pixmaps/kwrl.png"
    ln -sf kwrl.png "${pkgdir}/usr/share/icons/hicolor/32x32/apps/corvo.png"
    ln -sf kwrl.png "${pkgdir}/usr/share/icons/hicolor/128x128/apps/corvo.png"
    ln -sf kwrl.png "${pkgdir}/usr/share/pixmaps/corvo.png"
}
