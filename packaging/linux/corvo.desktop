[Desktop Entry]
Name=Corvo
GenericName=Cliente de E-mail Calmo
Comment=Cliente de e-mail calmo e seguro com IA local llama.cpp e Gmail OAuth2
Exec=corvo-desktop %u
Icon=corvo
Terminal=false
Type=Application
