# Credenciais da aplicação Kwrl (geradas 1 única vez na Google Cloud Console)
# Cola abaixo o Client ID e Client Secret do tipo "Desktop app" para ativar o botão "Continuar com Google":
KWRL_GOOGLE_CLIENT_ID=
KWRL_GOOGLE_CLIENT_SECRET=

# Compatibilidade retroativa (opcional):
# CORVO_GOOGLE_CLIENT_ID=
# CORVO_GOOGLE_CLIENT_SECRET=
